{
	"name": "@randomm/pi-permissions",
	"version": "0.1.0",
	"type": "module",
	"license": "Apache-2.0",
	"keywords": [
		"pi-package",
		"pi-extension",
		"permissions",
		"deny-by-default",
		"security"
	],
	"pi": {
		"extensions": ["./index.ts"]
	},
	"peerDependencies": {
		"@mariozechner/pi-coding-agent": "*"
	},
	"dependencies": {},
	"devDependencies": {
		"@biomejs/biome": "1.9.4",
		"@types/node": "^20.0.0",
		"typescript": "^5.0.0",
		"vitest": "2"
	},
	"files": ["*.ts", "README.md"],
	"scripts": {
		"test": "vitest run",
		"test:coverage": "vitest run --coverage",
		"lint": "biome check .",
		"format": "biome format --write .",
		"typecheck": "tsc --noEmit"
	}
}
